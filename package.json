{
  "name": "ai-village",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "depcheck": "dependency-cruiser --config .dependency-cruiser.cjs --validate packages apps",
    "doctor": "node tools/doctor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
